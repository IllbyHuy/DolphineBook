<Window x:Class="Library.DetailAuthorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Library"
        mc:Ignorable="d"
        Title="DetailAuthorWindow" Height="450" Width="800" Background="#6F50FF">
    <Grid>
        <Rectangle HorizontalAlignment="Left" Height="225" Margin="38,128,0,0" Stroke="Black" VerticalAlignment="Top" Width="611" Fill="#fff" RadiusX="10" RadiusY="10" />

        <Label Content="Create Author" FontSize="30" HorizontalAlignment="Left" Height="62" Margin="38,29,0,0" VerticalAlignment="Top" Width="272" Foreground="#fff"/>

        <Label Content="Author name" FontSize="12" HorizontalAlignment="Left" Height="31" Margin="83,156,0,0" VerticalAlignment="Top" Width="96" Foreground="Black"/>
        <TextBox x:Name="AuthorNameTextBox" HorizontalAlignment="Left" Height="22" Margin="184,156,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="207"/>

        <Label Content="Author Id" FontSize="12" HorizontalAlignment="Left" Height="24" Margin="83,192,0,0" VerticalAlignment="Top" Width="78" Foreground="Black"/>
        <TextBox x:Name="AuthorIdTextBox" HorizontalAlignment="Left" Height="22" Margin="184,195,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="207"/>
        <Button Content="Save" FontSize="14" HorizontalAlignment="Left" Height="34" Margin="83,252,0,0" VerticalAlignment="Top" Width="78" Click="SaveButton_Click"/>
        <Button Content="Quit" FontSize="14" HorizontalAlignment="Left" Height="33" Margin="194,252,0,0" VerticalAlignment="Top" Width="78" Click="CloseButton_Click"/>




    </Grid>
</Window>

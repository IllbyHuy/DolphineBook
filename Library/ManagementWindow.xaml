<Window x:Class="Library.ManagementWindow"
                        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Dolphin Book" Height="685" Width="1265" Background="#6F50FF" WindowStartupLocation="CenterScreen" ResizeMode="NoResize" Loaded="Window_Loaded" >
    <Grid>

        <Label Content="Dolphin Book" HorizontalAlignment="Left" Height="80" Margin="31,20,0,0" VerticalAlignment="Top" Width="569" FontWeight="Heavy" FontSize="50" FontStyle="Italic" Foreground="#fff"/>
        <Label Content="ver.01" HorizontalAlignment="Left" Height="50" Margin="370,42,0,0" VerticalAlignment="Top" Width="606" FontSize="30" Foreground="#fff" FontStyle="Italic"/>
        <Label x:Name="HelloMsgLabel" Content="Hello, Admin" HorizontalAlignment="Left" Height="50" Margin="929,6,0,0" VerticalAlignment="Top" Width="315" FontSize="25" FontStyle="Italic" Style="{StaticResource YellowLabelStyle}" HorizontalContentAlignment="Right"/>

        <Button x:Name="CreateButton" Content="Create Book" HorizontalAlignment="Left" Height="50" Margin="40,142,0,0" VerticalAlignment="Top" Width="185" TabIndex="3" Click="CreateButton_Click"/>
        <Button x:Name="UpdateButton" Content="Update Book" HorizontalAlignment="Left" Height="50" Margin="266,142,0,0" VerticalAlignment="Top" Width="185" TabIndex="4" Click="UpdateButton_Click"/>
        <Button x:Name="DeleteButton" Content="Delete Book" HorizontalAlignment="Left" Height="50" Margin="505,142,0,0" VerticalAlignment="Top" Width="185" TabIndex="5" Click="DeleteButton_Click"/>

        <DataGrid x:Name="BookGrid" HorizontalAlignment="Left" Height="385" Margin="40,214,0,0" VerticalAlignment="Top" Width="1204" AutoGenerateColumns="False" TabIndex="7" >
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Width="40" Binding="{Binding BookId}" />
                <DataGridTextColumn Header="Name" Width="200" Binding="{Binding BookName}" />
                <DataGridTextColumn Header="Date" Width="70" Binding="{Binding Date}" />
                <DataGridTextColumn Header="AuthorId" Width="100" Binding="{Binding AuthorId}" />
                <DataGridTextColumn Header="Author Name" Width="200" Binding="{Binding Author.AuthorName}" />
                <DataGridTextColumn Header="Description" Width="250" Binding="{Binding Description}" />
                <DataGridTextColumn Header="Image" Width="70" Binding="{Binding Image}" />
                <DataGridTextColumn Header="Genre ID" Width="140" Binding="{Binding GenreId}" />
                <DataGridTextColumn Header="Genre Name" Width="140" Binding="{Binding Genre.GenreName}" />
            </DataGrid.Columns>
        </DataGrid>
        <Button x:Name="CreateAuthor" Content="Create Author" HorizontalAlignment="Left" Height="50" Margin="742,142,0,0" VerticalAlignment="Top" Width="185" TabIndex="3" Click="CreateAuthorButton"/>

    </Grid>
</Window>
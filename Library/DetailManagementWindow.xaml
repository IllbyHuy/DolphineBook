<Window x:Class="Library.DetailManagementWindow"
         xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Air Conditioner Detail" Height="755" Width="1150" Background="#6F50FF" ResizeMode="NoResize" WindowStartupLocation="CenterScreen" Loaded="Window_Loaded" >
    <Grid>
        <Label x:Name="DetailWindowMode" Content="Create | Update " HorizontalAlignment="Left" Height="80" Margin="38,20,0,0" VerticalAlignment="Top" Width="814" FontWeight="Heavy" FontSize="40" FontStyle="Italic" Foreground="#fff"/>

        <Rectangle HorizontalAlignment="Left" Height="565" Margin="38,128,0,0" Stroke="Black" VerticalAlignment="Top" Width="875" Fill="#fff" RadiusX="10" RadiusY="10" />

        <Label Content="ID" HorizontalAlignment="Left" Height="45" Margin="58,155,0,0" VerticalAlignment="Top" Width="107" Foreground="Black"/>
        <TextBox x:Name="BookIdTextBox" HorizontalAlignment="Left" Height="45" Margin="223,153,0,0" TextWrapping="Wrap"  VerticalAlignment="Top" Width="275" TabIndex="0"/>

        <Label Content="Name" HorizontalAlignment="Left" Height="45" Margin="58,218,0,0" VerticalAlignment="Top" Width="147" Foreground="Black"/>
        <TextBox x:Name="BookNameTextBox" HorizontalAlignment="Left" Height="45" Margin="223,216,0,0" TextWrapping="Wrap"  VerticalAlignment="Top" Width="635" TabIndex="1"/>

        <Label Content="Author " HorizontalAlignment="Left" Height="45" Margin="58,284,0,0" VerticalAlignment="Top" Width="128" Foreground="Black"/>
        <ComboBox x:Name="AuthorComboBox" HorizontalAlignment="Left" Height="45" Margin="223,283,0,0" VerticalAlignment="Top" Width="222" TabIndex="2"/>

        <Label Content="Date" HorizontalAlignment="Left" Height="45" Margin="58,351,0,0" VerticalAlignment="Top" Width="128" Foreground="Black"/>
        <DatePicker x:Name="PublicationDateDatePicker" HorizontalAlignment="Left" Height="45" Margin="223,351,0,0"  VerticalAlignment="Top" Width="137" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" TabIndex="3"/>


        <Label Content="Content" HorizontalAlignment="Left" Height="45" Margin="58,507,0,0" VerticalAlignment="Top" Width="140" Foreground="Black"/>
        <TextBox x:Name="ContentTextBox" HorizontalAlignment="Left" Height="186" Margin="223,507,0,0" TextWrapping="Wrap"  VerticalAlignment="Top" Width="690" TabIndex="4" AcceptsReturn="True" VerticalScrollBarVisibility="Visible" VerticalContentAlignment="Top"/>

        <Label Content="Decription:" HorizontalAlignment="Left" Height="45" Margin="58,422,0,0" VerticalAlignment="Top" Width="157" Foreground="Black"/>
        <TextBox x:Name="DecriptionTextBox" HorizontalAlignment="Left" Height="45" Margin="223,422,0,0" TextWrapping="Wrap"  VerticalAlignment="Top" Width="679" TabIndex="5"/>

        <Label Content="Image" HorizontalAlignment="Left" Height="45" Margin="434,351,0,0" VerticalAlignment="Top" Width="106" Foreground="Black"/>
        <TextBox x:Name="ImageTextBox" HorizontalAlignment="Left" Height="45" Margin="513,351,0,0" TextWrapping="Wrap"  VerticalAlignment="Top" Width="244" TabIndex="6"/>

        <Label Content="Genre" HorizontalAlignment="Left" Height="45" Margin="540,286,0,0" VerticalAlignment="Top" Width="148" Foreground="Black" RenderTransformOrigin="0.871,0.712"/>
        <ComboBox x:Name="GenreComboBox" HorizontalAlignment="Left" Height="45" Margin="614,286,0,0" VerticalAlignment="Top" Width="290" Background="#ff4500" TabIndex="7" FontWeight="Bold" FontSize="18"/>

        <Button x:Name="SaveButton" Content="Save" HorizontalAlignment="Left" Height="50" Margin="945,128,0,0" VerticalAlignment="Top" Width="165" TabIndex="8" Click="SaveButton_Click" />
        <Button x:Name="CloseButton" Content="Close" HorizontalAlignment="Left" Height="50" Margin="945,208,0,0" VerticalAlignment="Top" Width="165" TabIndex="9" Click="CloseButton_Click" />



    </Grid>
</Window>

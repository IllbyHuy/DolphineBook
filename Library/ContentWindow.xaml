<Window x:Class="Library.Content"
                        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:uc="clr-namespace:Library.UserControls"
        xmlns:icon="http://metro.mahapps.com/winfx/xaml/iconpacks"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        mc:Ignorable="d"
        ResizeMode="NoResize"
        Height="830"
        Width="1250">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="55" />
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="350" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--Background-->
        <Border CornerRadius="0 20 20 0"
                Background="#ffffff"
                Grid.ColumnSpan="4"
                Margin="27,68,-10,0" Grid.RowSpan="2">
            <ScrollViewer Margin="65,31,0,0">
                <Grid Margin="20">
                    <StackPanel>
                        <TextBlock x:Name="BookNameTextBlock" FontWeight="ExtraBold" FontSize="40" Margin="0,0,0,10" Width="699" />
                        <TextBlock x:Name="BookDateTextBlock" FontSize="16" Margin="0,0,0,10" />
                        <TextBlock x:Name="ContentTextBlock" FontSize="20" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Border>

        <!--Left Menu 1-->
        <Border CornerRadius="20"
                Background="#6145E3"
                Panel.ZIndex="2"
                Grid.RowSpan="2">

            <Grid>
                <!--App Title-->
                <TextBlock Text="Dolphin Book"
                           Foreground="#ffffff"
                           FontSize="16"
                           VerticalAlignment="Top"
                           Margin="0 30 0 0"
                           HorizontalAlignment="Center"
                           FontWeight="SemiBold">

                    <TextBlock.LayoutTransform>
                        <RotateTransform Angle="90" />
                    </TextBlock.LayoutTransform>
                </TextBlock>

                <!--Account Buttons-->
                <StackPanel Margin="0 170 0 0">
                    <!--Add Button-->
                </StackPanel>

            </Grid>
        </Border>

        <!--Left Menu 2-->


        <!--Top Section-->
        <Grid Grid.Column="2"
              Grid.ColumnSpan="2"
              Margin="40 30">

            <!--Search Textbox-->
            <Grid Width="500" HorizontalAlignment="Left">

                <Rectangle Width="1" Fill="#E9E9E9" Panel.ZIndex="2" HorizontalAlignment="Left" Margin="130 19 0 19"/>
            </Grid>

            <!--Top Menu-->
            <StackPanel Orientation="Horizontal" Margin="781,0,0,0">

                <Button Style="{StaticResource textBoxButton}"/>

            </StackPanel>
        </Grid>

        <Border
            Grid.ColumnSpan="4"
            VerticalAlignment="Top"
            Background="Transparent"
            MouseDown="MainBorder_MouseDown" Margin="50,0,0,0">
            <StackPanel
                Grid.Column="1"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                FlowDirection="RightToLeft"
                Orientation="Horizontal">

            </StackPanel>
        </Border>
        <Border CornerRadius="20"
                Background="#6F50FF"
                Panel.ZIndex="1" Height="98" VerticalAlignment="Center" Grid.ColumnSpan="4" Margin="10,0,-10,0">
            <StackPanel Orientation="Horizontal" Margin="65,25,0,0" >
                <Button Width="45"
        Height="46"
        Background="#6F50FF"
        Cursor="Hand"
        BorderThickness="0"
        Click="ReturnToDetailPage_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Border Background="{TemplateBinding Background}"
                    CornerRadius="10"
                    Padding="10">
                                <icon:PackIconMaterial Kind="ArrowLeft" Foreground="White" Width="24" Height="24" />
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                    <Button.Style>
                        <Style TargetType="{x:Type Button}">
                            <Setter Property="Background" Value="#6F50FF" />
                            <Style.Triggers>
                                <!-- Hiệu ứng khi di chuột vào -->
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#8A70FF" />
                                </Trigger>
                                <!-- Hiệu ứng khi nhấn vào -->
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter Property="Background" Value="#5A40D8" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>


                <Button Style="{StaticResource textBoxButton}" Background="#e9e9e9" Margin="20 10 0 10" Click="HomeButton">
                    <icon:PackIconMaterial Kind="Home"
                                    Foreground="#88878E" />
                </Button>

            </StackPanel>
        </Border>
        <Border CornerRadius="20"
        Background="#6F50FF"
        Panel.ZIndex="2" Height="44" VerticalAlignment="Top" Margin="451,0,0,0" Grid.Column="3">
            <StackPanel
    Grid.Column="1"
    HorizontalAlignment="Right"
    VerticalAlignment="Top"
    FlowDirection="RightToLeft"
    Orientation="Horizontal">
                <Button
    Click="Close_Click"
    Content="{StaticResource close_ico}"
    Style="{StaticResource HomeWindowButtonStyle}" />
                <Button
    Click="Maximize_Click"
    Content="{StaticResource maximize_ico}"
    Style="{StaticResource HomeWindowButtonStyle}" 
    Tag="IsMaximizeButton" />
                <Button
    Click="Minimize_Click"
    Content="{StaticResource minimize_ico}"
    Style="{StaticResource HomeWindowButtonStyle}"
    Tag="IsMinimizeButton" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
<Window x:Class="Library.LikeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:icon="http://metro.mahapps.com/winfx/xaml/iconpacks"
        xmlns:uc="clr-namespace:Library.UserControls"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        mc:Ignorable="d"
        ResizeMode="NoResize"
        Height="830"
        Width="1250">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
    </Window.Resources>



    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="55" />
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="350" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--background-->
        <Border CornerRadius="0 20 20 0"
            Background="#F8F7FC"
            Grid.Column="2"
            Grid.ColumnSpan="2"
            MouseDown="Border_MouseDown"
            MouseLeftButtonDown="Border_MouseLeftButtonDown"
            Margin="-25 0 0 0"
            Grid.RowSpan="2">
            <Grid HorizontalAlignment="Left" Background="#fff" Height="739" Margin="67,66,0,0" VerticalAlignment="Top" Width="877">
                <Label Content="About us" HorizontalAlignment="Left" Height="80" Margin="15,50,0,0" VerticalAlignment="Top" Width="281" Foreground="Black" FontSize="40" FontWeight="UltraBlack"/>
                <Border BorderBrush="Black" BorderThickness="0,5" HorizontalAlignment="Left" Height="5" Margin="15,110,0,0" VerticalAlignment="Top" Width="845">
                    <TextBox Height="0" TextWrapping="Wrap" Text="TextBox"/>
                </Border>
                <TextBlock FontSize="20" TextWrapping="Wrap" Text="            Chào mừng bạn đến với Dolphin Book, nền tảng đọc truyện online mang đến trải nghiệm tuyệt vời cho tất cả những ai yêu thích khám phá thế giới văn học. Chúng tôi tự hào cung cấp một kho tàng truyện phong phú, từ các tác phẩm kinh điển đến những câu chuyện hiện đại, từ tiểu thuyết lãng mạn đến truyện phiêu lưu kỳ thú, tất cả đều được cập nhật liên tục để thỏa mãn đam mê đọc của bạn." Margin="10,135,27,469"/>
                <TextBlock HorizontalAlignment="Left" Height="122" Margin="10,0,0,0" TextWrapping="Wrap" Text="           Sứ mệnh của Dolphin Book là kết nối độc giả với những tác phẩm hay nhất và cộng đồng những người có chung sở thích. Chúng tôi tin rằng mỗi câu chuyện đều có sức mạnh truyền cảm hứng và kết nối con người. Vì vậy, chúng tôi không ngừng cải thiện dịch vụ để mang đến những trải nghiệm đọc mượt mà, hấp dẫn và cá nhân hóa nhất." VerticalAlignment="Center" FontSize="20" Width="840"/>
                <Image HorizontalAlignment="Left" Height="276" Margin="290,436,0,0" VerticalAlignment="Top" Width="275" Source="/Resources/DALL.jpg"/>
            </Grid>
        </Border>

        <!--Left Menu 1-->
        <Border CornerRadius="20"
        Background="#6145E3"
        Panel.ZIndex="1"
        Grid.RowSpan="2">

            <Grid>
                <!--App Title-->
                <TextBlock Text="Dolphin Book"
                   Foreground="#ffffff"
                   FontSize="16"
                   VerticalAlignment="Top"
                   Margin="0 30 0 0"
                   HorizontalAlignment="Center"
                   FontWeight="SemiBold">

                    <TextBlock.LayoutTransform>
                        <RotateTransform Angle="90" />
                    </TextBlock.LayoutTransform>
                </TextBlock>

                <!--Account Buttons-->
                <StackPanel Margin="0 170 0 0">
                    <!--Add Button-->
                </StackPanel>

            </Grid>
        </Border>

        <!--Left Menu 2-->
        <Border CornerRadius="0 20 20 0"
        Background="#6F50FF"
        Grid.Column="1"
        Margin="-25 0 0 0"
        Grid.RowSpan="2">
            <Grid>
                <!--Top ComboBox-->
                <Image Margin="48,30,48,672" Source="/Resources/logobook.png" />

                <!--Menu Buttons-->
                <StackPanel Margin="25 180 0 0">
                    <uc:MenuButton  Title="Home"
                            Icon="HomeOutline" Height="54" MouseDoubleClick="HomeButton"/>
                    <uc:MenuButton Title="About us" IsActive="True"
                            Icon="ChartTimelineVariantShimmer"  
                            Height="54"/>
                </StackPanel>

                <!--Bottom Menu buttons-->
                <StackPanel VerticalAlignment="Bottom"
                            Margin="25 0 0 40">
                    <uc:MenuButton Title="Logout"
                                    Icon="Logout" MouseDoubleClick="MenuButton_MouseDoubleClick_1" />
                </StackPanel>

            </Grid>
        </Border>
        <!--Top Section-->
        <Grid Grid.Column="2"
      Grid.ColumnSpan="2"
      Margin="40 30">

            <!--Search Textbox-->

            <!--Top Menu-->
            <StackPanel Orientation="Horizontal"
                HorizontalAlignment="Right">

                <Button Style="{StaticResource textBoxButton}"/>

            </StackPanel>
        </Grid>
        <Border
    Grid.ColumnSpan="4"
    VerticalAlignment="Top"
    Background="Transparent"
    MouseDown="MainBorder_MouseDown" Margin="50,0,0,0">
            <StackPanel
        Grid.Column="1"
        HorizontalAlignment="Right"
        VerticalAlignment="Top"
        FlowDirection="RightToLeft"
        Orientation="Horizontal">
                <Button
        Click="Close_Click"
        Content="{StaticResource close_ico}"
        Style="{StaticResource HomeWindowButtonStyle}" />
                <Button
        Click="Maximize_Click"
        Content="{StaticResource maximize_ico}"
        Style="{StaticResource HomeWindowButtonStyle}" 
        Tag="IsMaximizeButton" />
                <Button
        Click="Minimize_Click"
        Content="{StaticResource minimize_ico}"
        Style="{StaticResource HomeWindowButtonStyle}"
        Tag="IsMinimizeButton" />
            </StackPanel>
        </Border>
    </Grid>
</Window>

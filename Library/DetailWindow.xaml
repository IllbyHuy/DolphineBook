<Window x:Class="Library.DetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:uc="clr-namespace:Library.UserControls"
        xmlns:icon="http://metro.mahapps.com/winfx/xaml/iconpacks"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        mc:Ignorable="d"
        ResizeMode="NoResize"
        Height="830"
        Width="1250">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="55" />
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="350" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--Background-->
        <Border CornerRadius="0 20 20 0"
                Background="#ffffff"
                Grid.ColumnSpan="4"
                Margin="27,68,-10,0" Grid.RowSpan="2">
            <Grid Margin="80,80,50,55" Background="#F5F5F5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Hình ảnh bên trái với viền -->
                <Border Background="#fff" BorderBrush="Gray" BorderThickness="2" CornerRadius="5" Margin="100,100,736,191" Grid.Column="1">
                    <Image x:Name="BookImage" Margin="2,8,1,0" Height="318" VerticalAlignment="Top" />
                </Border>

                <!-- Phần mô tả bên phải -->
                <StackPanel Margin="421,128,27,191" Grid.ColumnSpan="2">
                    <TextBlock x:Name="BookNameTextBlock" FontWeight="Bold" FontSize="30" Foreground="Black" />
                    <TextBlock x:Name="BookIdTextBlock" FontWeight="Bold" FontSize="16" Foreground="Black" />
                    <TextBlock x:Name="BookDateTextBlock" FontWeight="Bold" FontSize="16" Foreground="Black" />
                    <TextBlock x:Name="BookAuthorIdTextBlock" FontWeight="Bold" FontSize="16" Foreground="Black" />
                    <TextBlock x:Name="BookGenreIdTextBlock" FontWeight="Bold" FontSize="16" Foreground="Black" />

                    <!-- Phần giới thiệu -->
                    <StackPanel Orientation="Vertical" Margin="0,10,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="/Resources/info.png" Width="24" Height="24" Margin="0,0,5,0" />
                            <TextBlock Text="Description" FontWeight="Bold" FontSize="16" Foreground="Black" />
                        </StackPanel>
                        <TextBlock x:Name="BookDescriptionTextBlock" FontWeight="Regular" FontSize="14" Foreground="Black" />
                    </StackPanel>
                </StackPanel>



                <Button x:Name="BackButton" Width="120" Height="40" Margin="36,23,947,564" Grid.Column="1" Click="HomeButton">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <Border x:Name="Border" Background="#6F50FF" CornerRadius="20">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Border" Property="Background" Value="#9370DB"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <icon:PackIconMaterial Kind="KeyboardReturn" Foreground="White" Width="20" Height="20" Margin="0,0,5,0" />
                </Button>

                <Button Content="Read"
                        Grid.ColumnSpan="2"
                        HorizontalAlignment="Left"
                        Height="51"
                        Margin="100,471,0,0"
                        VerticalAlignment="Top"
                        Width="267"
                        Click="ViewContentButton_Click"
                        FontSize="16"
                        FontWeight="Bold"
                        Foreground="White"
                        Cursor="Hand"
                        BorderThickness="0">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background">
                                <Setter.Value>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#6F50FF" Offset="0.0" />
                                        <GradientStop Color="#6F50FF" Offset="1.0" />
                                    </LinearGradientBrush>
                                </Setter.Value>
                            </Setter>
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="Padding" Value="10,5" />
                            <Setter Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect Color="Black" Opacity="0.3" BlurRadius="10" />
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background">
                                        <Setter.Value>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#9370DB" Offset="0.0" />
                                                <GradientStop Color="#7B68EE" Offset="1.0" />
                                            </LinearGradientBrush>
                                        </Setter.Value>
                                    </Setter>
                                    <Setter Property="Effect">
                                        <Setter.Value>
                                            <DropShadowEffect Color="Black" Opacity="0.5" BlurRadius="15" />
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </Border>

        <!--Left Menu 1-->
        <Border CornerRadius="20"
                Background="#6145E3"
                Panel.ZIndex="2"
                Grid.RowSpan="2">

            <Grid>
                <!--App Title-->
                <TextBlock Text="Dolphin Book"
                           Foreground="#ffffff"
                           FontSize="16"
                           VerticalAlignment="Top"
                           Margin="0 30 0 0"
                           HorizontalAlignment="Center"
                           FontWeight="SemiBold">
                    <TextBlock.LayoutTransform>
                        <RotateTransform Angle="90" />
                    </TextBlock.LayoutTransform>
                </TextBlock>

                <!--Account Buttons-->
                <StackPanel Margin="0 170 0 0">
                    <!--Add Button-->
                </StackPanel>
            </Grid>
        </Border>

        <!--Top Section-->
        <Grid Grid.Column="2"
              Grid.ColumnSpan="2"
              Margin="40 30">
            <!--Search Textbox-->
            <Grid Width="500" HorizontalAlignment="Left">
                <Rectangle Width="1" Fill="#E9E9E9" Panel.ZIndex="2" HorizontalAlignment="Left" Margin="130 19 0 19"/>
            </Grid>

            <!--Top Menu-->
            <StackPanel Orientation="Horizontal" Margin="781,0,0,0">
                <Button Style="{StaticResource textBoxButton}"/>
            </StackPanel>
        </Grid>

        <Border
            Grid.ColumnSpan="4"
            VerticalAlignment="Top"
            Background="Transparent"
            MouseDown="MainBorder_MouseDown" Margin="50,0,0,0">
            <StackPanel
                Grid.Column="1"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                FlowDirection="RightToLeft"
                Orientation="Horizontal">
            </StackPanel>
        </Border>

        <Border CornerRadius="20"
                Background="#6F50FF"
                Panel.ZIndex="1" Height="98" VerticalAlignment="Center" Grid.ColumnSpan="4" Margin="10,0,-10,0">
            <StackPanel Orientation="Horizontal" Margin="47,25,0,0">
                <Button Style="{StaticResource textBoxButton}" Background="#e9e9e9" Margin="40 0 0 10" Click="HomeButton">
                    <icon:PackIconMaterial Kind="Home" Foreground="#88878E" />
                </Button>
            </StackPanel>
        </Border>

        <Border CornerRadius="20"
                Background="#6F50FF"
                Panel.ZIndex="2" Height="44" VerticalAlignment="Top" Margin="451,0,0,0" Grid.Column="3">
            <StackPanel
                Grid.Column="1"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                FlowDirection="RightToLeft"
                Orientation="Horizontal">
                <Button
                    Click="Close_Click"
                    Content="{StaticResource close_ico}"
                    Style="{StaticResource HomeWindowButtonStyle}" />
                <Button
                    Click="Maximize_Click"
                    Content="{StaticResource maximize_ico}"
                    Style="{StaticResource HomeWindowButtonStyle}" 
                    Tag="IsMaximizeButton" />
                <Button
                    Click="Minimize_Click"
                    Content="{StaticResource minimize_ico}"
                    Style="{StaticResource HomeWindowButtonStyle}"
                    Tag="IsMinimizeButton" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
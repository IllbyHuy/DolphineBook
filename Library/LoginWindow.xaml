<Window x:Class="Library.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:customcontrol="clr-namespace:Library.CustomControl"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Library"
        Title="LoginWindow" 
        Width="1200" 
        Height="724" 
        ResizeMode="NoResize" 
        WindowStartupLocation="CenterScreen" 
        WindowStyle="None"
        mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="415*"/>
            <RowDefinition Height="449*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="400" />
            <ColumnDefinition Width="196*" />
            <ColumnDefinition Width="941*"/>
        </Grid.ColumnDefinitions>

        <Grid Background="#F9F9F9" Grid.RowSpan="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="170" />
                <RowDefinition />
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel 
                Grid.Row="1"
                Margin="50,0"
                Orientation="Vertical">
                <Label 
                    Margin="15,0,0,25"
                    HorizontalAlignment="Center" 
                    Content="Sign in" 
                    FontSize="20" 
                    FontWeight="Bold" 
                    Foreground="#0A0A0A" />
                <customcontrol:WaterMarkTestBox x:Name="userNameTB" LabelMark="USERNAME" />
                <customcontrol:WaterMarkTestBox 
                    x:Name="passwordTB"
                    Margin="0,5,0,0"
                    IsPassword="True"
                    LabelMark="PASSWORD" Loaded="passwordTB_Loaded"/>

            </StackPanel>
            <Grid Grid.Row="2">
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Button 
                    Width="65" 
                    Height="65" 
                    Margin="0,0,0,55" 
                    Style="{StaticResource LoginButton}" Click="Button_Click"/>
                <Grid Grid.Row="1" Margin="0,0,0,50">
                    <Grid.Resources>
                        <Style TargetType="Label">
                            <Setter Property="Foreground" Value="#AFB3B3"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="Foreground" Value="#AFB3B3"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Foreground" Value="Black"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Resources>

                    <Label HorizontalAlignment="Center" Content=" CAN'T SIGN IN" />
                    <Label 
                        Margin="0,5,30,0" 
                        HorizontalAlignment="Right" 
                        Content="V0.0.1" 
                        FontSize="12" />
                </Grid>
            </Grid>
            <Image 
                Height="70" 
                Source="/Resources/logobook.png" 
                Stretch="Uniform" />
        </Grid>
        <Image Grid.Column="1" HorizontalAlignment="Left" Height="724" VerticalAlignment="Top" Width="798" Margin="2,0,0,0" Source="/Resources/Róse.jpg" Stretch="Fill" Grid.RowSpan="2" Grid.ColumnSpan="2"/>
        <Border
            Grid.ColumnSpan="3"
            VerticalAlignment="Top"
            Background="Transparent"
            MouseDown="MainBorder_MouseDown">
            <StackPanel
                Grid.Column="1"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                FlowDirection="RightToLeft"
                Orientation="Horizontal">
                <Button
                    Click="Close_Click"
                    Content="{StaticResource close_ico}"
                    Style="{StaticResource WindowButtonStyle}" />
                <Button
                    Click="Minimize_Click"
                    Content="{StaticResource minimize_ico}"
                    Style="{StaticResource WindowButtonStyle}"
                    Tag="IsMinimizeButton" />
            </StackPanel>
        </Border>
    </Grid>
</Window>

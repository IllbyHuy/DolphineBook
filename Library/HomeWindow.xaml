<Window x:Class="Library.HomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:uc="clr-namespace:Library.UserControls"
        xmlns:icon="http://metro.mahapps.com/winfx/xaml/iconpacks"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        mc:Ignorable="d"
        ResizeMode="NoResize"
        Height="830"
        Width="1250">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="55" />
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="350" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--Background-->
        <Border CornerRadius="0 20 20 0"
                Background="#F8F7FC"
                Grid.Column="1"
                Grid.ColumnSpan="3"
                MouseDown="Border_MouseDown"
                MouseLeftButtonDown="Border_MouseLeftButtonDown"
                Margin="207,0,-12,0"
                Grid.RowSpan="2" >
            <Label Content="Truyện" HorizontalAlignment="Left" Height="28" Margin="58,124,0,0" VerticalAlignment="Top" Width="74" FontSize="15" FontFamily="Arial" FontWeight="ExtraBlack"/>
        </Border>

        <!--Left Menu 1-->
        <Border CornerRadius="20"
                Background="#6145E3"
                Panel.ZIndex="2"
                Grid.RowSpan="2">

            <Grid>
                <!--App Title-->
                <TextBlock Text="Dolphin Book"
                           Foreground="#ffffff"
                           FontSize="16"
                           VerticalAlignment="Top"
                           Margin="0 30 0 0"
                           HorizontalAlignment="Center"
                           FontWeight="SemiBold">

                    <TextBlock.LayoutTransform>
                        <RotateTransform Angle="90" />
                    </TextBlock.LayoutTransform>
                </TextBlock>

                <!--Account Buttons-->
                <StackPanel Margin="0 170 0 0">
                    <!--Add Button-->
                </StackPanel>

            </Grid>
        </Border>

        <!--Left Menu 2-->
        <Border CornerRadius="0 20 20 0"
                Background="#6F50FF"
                Grid.Column="1"
                Margin="-25 0 0 0"
                Panel.ZIndex="1"
                Grid.RowSpan="2">

            <Grid>
                <!--Top ComboBox-->
                <Image Margin="48,30,48,672" Source="/Resources/logobook.png" />

                <!--Menu Buttons-->
                <StackPanel Margin="25 180 0 0">
                    <uc:MenuButton  Title="Home" IsActive="True"
                                    Icon="HomeOutline" Height="54"/>
                    <uc:MenuButton Title="About us"
                       Icon="ChartTimelineVariantShimmer" 
                                   MouseDoubleClick="LikeButton" 
                                   Height="54"/>


                </StackPanel>

                <!--Bottom Menu buttons-->
                <StackPanel VerticalAlignment="Bottom"
                Margin="25 0 0 40">
                    <uc:MenuButton Title="Logout"
                       Icon="Logout" MouseDoubleClick="MenuButton_MouseDoubleClick" />
                </StackPanel>

            </Grid>
        </Border>

        <!--Top Section-->
        <Grid Grid.Column="2"
              Grid.ColumnSpan="2"
              Margin="40 30">

            <!--Search Textbox-->
            <Grid Width="500" HorizontalAlignment="Left">

                <ComboBox x:Name="comboBoxFilter" Style="{DynamicResource ComboBoxStyle1}" HorizontalAlignment="Left" Margin="3 0 0 0" Panel.ZIndex="2">
                    <ComboBoxItem Content="All" IsSelected="True"  />
                    <ComboBoxItem Content="Genre" />
                </ComboBox>

                <Rectangle Width="1" Fill="#E9E9E9" Panel.ZIndex="2" HorizontalAlignment="Left" Margin="130 19 0 19"/>

                <TextBlock Margin="160 0 20 0"
                           VerticalAlignment="Center"
                           Foreground="#868686"
                           IsHitTestVisible="False"
                           Panel.ZIndex="1"
                           Text="Search here ..."
                           Visibility="{Binding ElementName=textBoxSearch, Path=Text.IsEmpty, Converter={StaticResource BoolToVisConverter}}" />

                <TextBox Name="textBoxSearch" Style="{StaticResource searchTextbox}" TextChanged="textBoxSearch_TextChanged" />

                <Button Style="{StaticResource textBoxButton}" HorizontalAlignment="Right" Margin="0 0 7 0">
                    <icon:PackIconMaterial Kind="Magnify" Width="15" Foreground="#c7c7c7" />
                </Button>
            </Grid>

            <!--Top Menu-->
        </Grid>

        <ScrollViewer Grid.Column="2" Grid.ColumnSpan="2" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="40,54,0,0">
            <WrapPanel x:Name="DataWrapPanel" Margin="0,0,0,0" Width="980">
                <!-- Nội dung sẽ được thêm vào đây -->
            </WrapPanel>
        </ScrollViewer>

        <Border
            Grid.ColumnSpan="4"
            VerticalAlignment="Top"
            Background="Transparent"
            MouseDown="MainBorder_MouseDown" Margin="50,0,0,0">
            <StackPanel
                Grid.Column="1"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                FlowDirection="RightToLeft"
                Orientation="Horizontal">
                <Button
                Click="Close_Click"
                Content="{StaticResource close_ico}"
                Style="{StaticResource HomeWindowButtonStyle}" />
                <Button
                Click="Maximize_Click"
                Content="{StaticResource maximize_ico}"
                Style="{StaticResource HomeWindowButtonStyle}" 
                Tag="IsMaximizeButton" />
                <Button
                Click="Minimize_Click"
                Content="{StaticResource minimize_ico}"
                Style="{StaticResource HomeWindowButtonStyle}"
                Tag="IsMinimizeButton" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
